+                success = cont.solve()
+            except:
+                status = "failure"
+                success = False
+            time_mpc_e = time.time() - time_mpc_s
+            time_solver_e = cont.problem.solver_stats.solve_time
+            time_e = time.time() - time_s
+            if not success:
+                status = "infeasible"
+                break
+            v = cont.get_solved_control(x, k=0)
+            noise = integrator.get_noise(x, v)
+            x = integrator.solve_time_step(x, v)
+            ts += 1
+            all_results.append(
