+import time
+import numpy as np
+
+from utils_aux import  compute_goal_state, interpolate_equidistant, get_tracking_path_clearance
+from corridor_simulators.base import BaseSimulator
+
+
+class NomSimulator(BaseSimulator):
+
+
+    def simulate(
+            self,
+            path_centers,
+            path_radii,
+            nr_steps=1000,
+            goal_tol=1e-2,
+            verbose=False,
+            compute_tracking_path=False
+    ):
+        cont = self.cont
+        world = self.world
+        integrator = self.integrator
+        N = cont.N
+        m_x, m_u = cont.A.shape
