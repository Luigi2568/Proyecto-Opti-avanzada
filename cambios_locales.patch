+def sample_query(world, dist_margin=0.):
+    while True:
+        q_s = world.sample_coll_free()
+        r_s = world.sdf(q_s)
+        if r_s < dist_margin:
+            continue
+        q_g = world.sample_coll_free()
+        r_g = world.sdf(q_g)
+        if r_g < dist_margin:
+            continue
+        status = is_collision_free_bisection(q_s, q_g, world.sdf)
+        if not status:
+            break
+    return q_s, q_g
+
